#!/usr/bin/env bash
# Runs the agent-coordinator binary that Claude Code installed from this plugin's pinned npm packages.
set -euo pipefail

root="${CLAUDE_PLUGIN_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
ext=""
case "$(uname -s)" in
  Linux) os=linux ;;
  Darwin) os=darwin ;;
  MINGW* | MSYS* | CYGWIN*) os=win32 ext=.exe ;;
  *) os=unsupported ;;
esac
case "$(uname -m)" in
  x86_64 | amd64) arch=x64 ;;
  aarch64 | arm64) arch=arm64 ;;
  *) arch=unsupported ;;
esac
bin="$root/node_modules/agent-coordinator-cli-$os-$arch/agent-coordinator$ext"

if [ ! -x "$bin" ]; then
  # Hooks fail open so sessions keep working without the binary.
  [ "${1:-}" = hook ] && exit 0
  echo "agent-coordinator plugin: $bin not found; reinstall the plugin so Claude Code installs its pinned npm packages" >&2
  exit 1
fi
exec "$bin" "$@"
